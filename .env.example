COVA_SESSION_RELAYER_PRIVATE_KEY=
COVA_SESSION_RATE_PER_MINUTE=500000
COVA_SESSION_MAX_DURATION_SECONDS=2400
COVA_SESSION_START_WINDOW_SECONDS=300
COVA_SESSION_SETTLEMENT_GRACE_SECONDS=3600
