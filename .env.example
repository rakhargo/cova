DEPLOYER_PRIVATE_KEY=
USDG_ADDRESS=0xFFC95faa3d63Cde504a05B567C600B78C0b41892

# Timed-session checkout API. Keep signing keys server-only; never use DEPLOYER_PRIVATE_KEY here.
COVA_SESSION_CHAIN_ID=421614
COVA_SESSION_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
COVA_SESSION_ROUTER_ADDRESS=0xe8ba68458e932921f5401f48eb36ed881255db5a
COVA_SESSION_VAULT_ADDRESS=0xC5E8bd21b3691815e9F0CD7e4F80C656A56C1eD5
