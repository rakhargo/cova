# Confirmed Arbitrum Sepolia deployment. Clear the vault address for Demo Mode.
NEXT_PUBLIC_COVA_DEPLOYMENT_BLOCK=315667402
NEXT_PUBLIC_COVA_VAULT_ADDRESS=0xC5E8bd21b3691815e9F0CD7e4F80C656A56C1eD5
